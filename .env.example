# ============================================================
# HƯƠNG SẮC XỨ MƯỜNG – CẤU HÌNH MÔI TRƯỜNG
# Sao chép file này thành .env rồi điền giá trị thật.
# KHÔNG commit file .env lên GitHub.
# ============================================================

# 1) SUPABASE (bắt buộc khi chạy thật nhiều thiết bị)
# Lấy tại Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 2) ĐỊA CHỈ WEBSITE (dùng để tạo mã QR và link chia sẻ)
VITE_SITE_URL=https://huongsacxumuong.vn

# 3) CHẾ ĐỘ CHẠY THỬ CỤC BỘ (khi chưa có Supabase)
# Mật khẩu đăng nhập /admin ở chế độ local. Đổi trước khi dùng thật.
VITE_LOCAL_ADMIN_PASSWORD=HuongSac@2026

# 4) THÔNG TIN CHUYỂN KHOẢN (có thể sửa trực tiếp trong /admin → Cấu hình)
# BIN ngân hàng: MB=970422, Vietcombank=970436, Techcombank=970407,
# Agribank=970405, BIDV=970418, VietinBank=970415, ACB=970416
VITE_BANK_BIN=970422
VITE_BANK_ACCOUNT_NO=0000000000
VITE_BANK_ACCOUNT_NAME=TRUONG PT DTNT THPT HOA BINH
VITE_BANK_NAME=MB Bank

# 5) BẢN ĐỒ (Google Maps → Chia sẻ → Nhúng bản đồ → sao chép src của iframe)
VITE_MAP_EMBED_URL=https://www.google.com/maps?q=Truong%20PT%20DTNT%20THPT%20Hoa%20Binh%2C%20Tan%20Hoa%2C%20Hoa%20Binh&output=embed

# 6) TELEGRAM (tùy chọn – mặc định thông báo hiển thị trong /admin)
# Nếu muốn nhận Telegram: tạo bot với @BotFather, lấy chat_id,
# rồi khai báo secret cho Edge Function (xem docs/TRIEN-KHAI.md).
VITE_TELEGRAM_ENABLED=false

# 7) HOTLINE BAN TỔ CHỨC
VITE_HOTLINE=0218 3851 234
